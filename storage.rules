rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn()
        && (!('status' in userProfile()) || userProfile().status == 'active')
        ? userProfile().role
        : null;
    }

    function inOrganisation(orgId) {
      return signedIn()
        && userProfile().organisationId == orgId
        && role() in [
          'super_admin', 'organisation_admin', 'programme_director',
          'finance', 'teacher', 'viewer'
        ];
    }

    function canManageDocuments(orgId) {
      return inOrganisation(orgId)
        && role() in ['super_admin', 'organisation_admin', 'programme_director', 'teacher'];
    }

    function canManageBranding(orgId) {
      return inOrganisation(orgId)
        && role() in ['super_admin', 'organisation_admin'];
    }

    function safeDocumentUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'image/jpeg', 'image/png', 'image/webp', 'text/plain', 'text/csv',
          'audio/mpeg', 'audio/mp4', 'audio/wav', 'video/mp4'
        ];
    }

    function safeImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /organisations/{orgId}/branding/{fileName} {
      allow read: if inOrganisation(orgId);
      allow create, update: if canManageBranding(orgId) && safeImageUpload();
      allow delete: if canManageBranding(orgId);
    }

    match /organisations/{orgId}/documents/{documentId}/{version}/{fileName} {
      allow read: if inOrganisation(orgId);
      allow create, update: if canManageDocuments(orgId) && safeDocumentUpload();
      allow delete: if canManageDocuments(orgId);
    }

    match /organisations/{orgId}/learners/{learnerId}/{fileName} {
      allow read: if inOrganisation(orgId);
      allow create, update: if canManageDocuments(orgId) && safeDocumentUpload();
      allow delete: if canManageDocuments(orgId);
    }

    match /organisations/{orgId}/guardians/{guardianId}/{fileName} {
      allow read: if inOrganisation(orgId);
      allow create, update: if canManageDocuments(orgId) && safeDocumentUpload();
      allow delete: if canManageDocuments(orgId);
    }

    match /organisations/{orgId}/exports/{fileName} {
      allow read: if inOrganisation(orgId)
        && role() in ['super_admin', 'organisation_admin'];
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
