rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // A user is considered in an organisation if their user record's organisationId matches
    function isUserInOrg(orgId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == orgId
      );
    }
    
    function isOrgUnchanged() {
      return !('organisationId' in request.resource.data) || 
             (resource.data.organisationId == request.resource.data.organisationId);
    }
    
    function hasCreatedBy() {
      return 'createdBy' in request.resource.data && request.resource.data.createdBy != null;
    }

    // Special rule for users collection
    match /users/{userId} {
      // User can read/write their own auth profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Organisations
    match /organisations/{orgId} {
      allow read: if isUserInOrg(orgId);
      allow create: if isAuthenticated();
      allow update: if isUserInOrg(orgId);
      allow delete: if false; 
    }

    // ─── Phase 1A Collections ────────────────────────────────────

    match /learners/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // soft delete only
    }

    match /guardians/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; 
    }

    match /learnerGuardians/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; 
    }

    match /staff/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; 
    }

    match /programmes/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; 
    }

    match /programmeGroups/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; 
    }

    // ─── Phase 1B Collections ────────────────────────────────────

    match /enrolments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /sessions/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /attendance/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /followUps/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    // ─── Phase 2A Collections (Music) ────────────────────────────

    match /instruments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /instrumentAllocations/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /repertoire/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /sessionRepertoire/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // soft delete or actual delete is allowed in service, wait, service uses delete(). Let's allow actual delete for sessionRepertoire
    }

    match /practiceLogs/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId); // service allows delete
    }

    match /musicAssessments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId); // service allows delete
    }

    // ─── Phase 2B Collections (Dance) ────────────────────────────

    match /danceLevels/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /choreography/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /sessionChoreography/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /dancePracticeLogs/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId);
    }

    match /danceAssessments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId);
    }

    match /costumes/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /costumeAllocations/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    // ─── Phase 3A Collections (Events) ───────────────────────────

    match /events/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventGroups/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventParticipants/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventStaff/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventScheduleItems/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventPerformanceItems/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventAttendance/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    // ─── Phase 3B Collections (Consent & Transport) ───────────────

    match /consentTemplates/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /consentRequests/{docId} {
      // Allow read for organization staff or direct access for guardian submission
      allow read: if isUserInOrg(resource.data.organisationId) || resource != null;
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if (isUserInOrg(resource.data.organisationId) || resource != null) && isOrgUnchanged();
      allow delete: if false;
    }

    match /consentSubmissions/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if request.resource.data.organisationId != null;
      // Verified consent evidence cannot be altered except when superseding
      allow update: if (isUserInOrg(resource.data.organisationId) || resource != null) && isOrgUnchanged()
                    && (resource.data.submissionStatus != 'verified' || request.resource.data.submissionStatus == 'superseded');
      allow delete: if false; // Immutable evidence
    }

    match /transportProviders/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /transportVehicles/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /eventTransportPlans/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /transportPassengers/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    // ─── Phase 4A Collections: Finance & Payments ─────────────────

    match /chargeTypes/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Archive only
    }

    match /charges/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Cannot delete charges, waive/cancel only
    }

    match /invoices/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Invoices are permanent financial records
    }

    match /invoiceLineItems/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /payments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Payments cannot be deleted, reverse only
    }

    match /paymentAllocations/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId); // Allowed during payment reversal rollback
    }

    match /financeAdjustments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /invoiceCounters/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /paymentCounters/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Phase 4B Collections (Communication & Documents) ─────────

    match /communications/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Communications are historical audit records
    }

    match /communicationRecipients/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /communicationTemplates/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Archive only
    }

    match /communicationAttachments/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    match /documents/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Archive only
    }

    match /documentVersions/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Immutable version history
    }

    match /documentTemplates/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Archive only
    }

    match /documentLinks/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId); // Allowed for unlinking documents
    }

    // ─── Phase 5A Collections (Operational Intelligence) ──────────

    match /operationalAlerts/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    // ─── Phase 5B Collections (Workflow Automation & Notifications) ─

    match /automationRules/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if isUserInOrg(resource.data.organisationId);
    }

    match /automationExecutions/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update, delete: if false; // Immutable execution history & system evidence
    }

    match /notifications/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false; // Dismiss only
    }

    match /notificationPreferences/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId) && hasCreatedBy();
      allow update: if isUserInOrg(resource.data.organisationId) && isOrgUnchanged();
      allow delete: if false;
    }

    // ─── Audit Logs ──────────────────────────────────────────────

    match /auditLogs/{docId} {
      allow read: if isUserInOrg(resource.data.organisationId);
      allow create: if isUserInOrg(request.resource.data.organisationId);
      allow update, delete: if false; // Cannot be edited or deleted
    }
  }
}
