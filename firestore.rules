rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function userProfile() {
      return get(userPath()).data;
    }

    function role() {
      return hasUserProfile()
        && (!('status' in userProfile()) || userProfile().status == 'active')
        ? userProfile().role
        : null;
    }

    function organisationId() {
      return hasUserProfile() ? userProfile().organisationId : null;
    }

    function isInternal() {
      return role() in [
        'super_admin', 'organisation_admin', 'programme_director',
        'finance', 'teacher', 'viewer'
      ];
    }

    function isPlatformAdmin() {
      return signedIn() && (
        role() == 'super_admin' ||
        (hasUserProfile() && 'platformRole' in userProfile() && userProfile().platformRole == 'super_admin')
      );
    }

    function isAdmin() {
      return role() in ['super_admin', 'organisation_admin'];
    }

    function isProgrammeManager() {
      return role() in ['super_admin', 'organisation_admin', 'programme_director'];
    }

    function isTeacher() {
      return role() in ['super_admin', 'organisation_admin', 'programme_director', 'teacher'];
    }

    function isFinance() {
      return role() in ['super_admin', 'organisation_admin', 'finance'];
    }

    function isViewer() {
      return isInternal();
    }

    function sameOrganisation(orgId) {
      return isInternal() && organisationId() == orgId;
    }

    function validStatus(value) {
      return value in ['active', 'inactive', 'archived', 'deleted'];
    }

    function validNewBaseRecord(docId) {
      return request.resource.data.id == docId
        && request.resource.data.organisationId is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && validStatus(request.resource.data.status)
        && request.resource.data.keys().size() <= 80;
    }

    function validBaseRecordUpdate() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.organisationId == resource.data.organisationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && validStatus(request.resource.data.status)
        && request.resource.data.keys().size() <= 80;
    }

    function inOrganisationOnRead() {
      return sameOrganisation(resource.data.organisationId);
    }

    function inOrganisationOnCreate(docId) {
      return sameOrganisation(request.resource.data.organisationId)
        && validNewBaseRecord(docId);
    }

    function inOrganisationOnUpdate() {
      return sameOrganisation(resource.data.organisationId)
        && validBaseRecordUpdate();
    }

    function isPeopleCollection(name) {
      return name in [
        'learners', 'guardians', 'learnerGuardians', 'programmes',
        'programmeGroups', 'enrolments', 'followUps', 'instruments',
        'instrumentAllocations', 'repertoire', 'sessionRepertoire',
        'practiceLogs', 'musicAssessments', 'danceLevels', 'choreography',
        'sessionChoreography', 'dancePracticeLogs', 'danceAssessments',
        'costumes', 'costumeAllocations'
      ];
    }

    function isStaffCollection(name) {
      return name == 'staff';
    }

    function canReadAttendanceOrEvents() {
      return role() in [
        'super_admin', 'organisation_admin', 'programme_director', 'teacher', 'viewer'
      ];
    }

    function canReadStaff() {
      return role() in ['super_admin', 'organisation_admin', 'programme_director', 'viewer'];
    }

    function canReadSettings() {
      return role() in ['super_admin', 'organisation_admin', 'programme_director', 'finance', 'viewer'];
    }

    function archiveAuthorityPreserved() {
      return request.resource.data.status == resource.data.status || isAdmin();
    }

    function isAttendanceCollection(name) {
      return name in ['sessions', 'attendance'];
    }

    function isEventCollection(name) {
      return name in [
        'events', 'eventGroups', 'eventParticipants', 'eventStaff',
        'eventScheduleItems', 'eventPerformanceItems', 'eventAttendance',
        'consentTemplates', 'consentRequests', 'consentSubmissions',
        'transportProviders', 'transportVehicles', 'eventTransportPlans',
        'transportPassengers'
      ];
    }

    function isFinanceCollection(name) {
      return name in [
        'chargeTypes', 'charges', 'invoices', 'invoiceLineItems', 'payments',
        'paymentAllocations', 'financeAdjustments', 'invoiceCounters',
        'paymentCounters'
      ];
    }

    function isCommunicationCollection(name) {
      return name in [
        'communications', 'communicationRecipients', 'communicationTemplates',
        'communicationAttachments', 'documents', 'documentVersions',
        'documentTemplates', 'documentLinks'
      ];
    }

    function isAutomationCollection(name) {
      return name in [
        'operationalAlerts', 'automationRules', 'automationExecutions',
        'notifications', 'notificationPreferences'
      ];
    }

    function isWorkforceCollection(name) {
      return name in [
        'staffAssignments', 'staffAvailability', 'staffWorkRecords',
        'timesheets', 'timesheetEntries', 'staffSubstitutions'
      ];
    }

    function isSettingsCollection(name) {
      return name in [
        'organisationCalendarPeriods', 'organisationInvitations'
      ];
    }

    function isPortalCollection(name) {
      return name in [
        'guardianPortalAccess', 'guardianInvitations', 'learnerPortalAccess',
        'learnerInvitations', 'portalChangeRequests'
      ];
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'organisationId', 'role', 'status'
        ])
        && request.resource.data.organisationId == 'org_' + request.auth.uid
        && request.resource.data.role == 'organisation_admin'
        && request.resource.data.status == 'active'
        && exists(/databases/$(database)/documents/organisations/$(request.resource.data.organisationId));
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName'
        ]);
      allow update: if isAdmin()
        && resource.data.organisationId == organisationId()
        && request.resource.data.organisationId == resource.data.organisationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'role', 'status'
        ])
        && request.resource.data.role in [
          'organisation_admin', 'programme_director', 'finance', 'teacher', 'viewer'
        ]
        && request.resource.data.status in ['active', 'disabled'];
      allow delete: if false;
    }

    match /organisations/{orgId} {
      allow get: if sameOrganisation(orgId)
        || (signedIn() && orgId == 'org_' + request.auth.uid)
        || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        || (signedIn()
          && !hasUserProfile()
          && orgId == 'org_' + request.auth.uid
          && request.resource.data.keys().hasOnly([
            'id', 'organisationId', 'name', 'organisationType', 'email', 'phone',
            'address', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
          ])
          && request.resource.data.id == orgId
          && request.resource.data.organisationId == orgId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160
          && validNewBaseRecord(orgId));
      allow update: if isPlatformAdmin()
        || (sameOrganisation(orgId) && isAdmin() && validBaseRecordUpdate()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'assignedPlanId', 'tenantStatus', 'suspensionReason', 'restrictionReason'
            ]));
      allow delete: if false;
    }

    match /organisationSettings/{orgId} {
      allow read: if sameOrganisation(orgId) && isViewer();
      allow create: if sameOrganisation(orgId)
        && isAdmin()
        && request.resource.data.organisationId == orgId;
      allow update: if sameOrganisation(orgId)
        && isAdmin()
        && request.resource.data.organisationId == resource.data.organisationId;
      allow delete: if false;
    }

    match /auditLogs/{docId} {
      allow read: if (inOrganisationOnRead() && isAdmin()) || isPlatformAdmin();
      allow create: if (inOrganisationOnCreate(docId) && isInternal()) || isPlatformAdmin();
      allow update, delete: if false;
    }

    match /organisationMemberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        (inOrganisationOnRead() && canReadSettings()) ||
        isPlatformAdmin()
      );
      allow create: if isPlatformAdmin() || (
        inOrganisationOnCreate(membershipId)
        && isAdmin()
        && request.resource.data.role != 'super_admin'
        && request.resource.data.userId is string
      );
      allow update: if isPlatformAdmin() || (
        inOrganisationOnUpdate()
        && isAdmin()
        && request.resource.data.role != 'super_admin'
      );
      allow delete: if false;
    }

    // SaaS 2A: Platform Plans, Features & Entitlements Security Rules
    match /platformFeatures/{featureKey} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /planEntitlements/{entitlementId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /organisationEntitlementOverrides/{overrideId} {
      allow read: if isPlatformAdmin() || (signedIn() && sameOrganisation(resource.data.organisationId));
      allow write: if isPlatformAdmin();
    }

    // SaaS 2B: Trials, Subscriptions & Commercial Billing Security Rules
    match /subscriptions/{subscriptionId} {
      allow read: if isPlatformAdmin() || (signedIn() && sameOrganisation(resource.data.organisationId));
      allow write: if isPlatformAdmin();
    }

    match /planPrices/{priceId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /billingCustomers/{customerId} {
      allow read: if isPlatformAdmin() || (signedIn() && sameOrganisation(resource.data.organisationId));
      allow write: if isPlatformAdmin();
    }

    match /saasCheckoutSessions/{sessionId} {
      allow read: if isPlatformAdmin() || (signedIn() && sameOrganisation(resource.data.organisationId));
      allow create: if isPlatformAdmin() || (
        signedIn() &&
        role() == 'organisation_admin' &&
        sameOrganisation(request.resource.data.organisationId)
      );
      allow update, delete: if isPlatformAdmin();
    }

    match /saasBillingEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    // SaaS 3A: Customer Provisioning & School Onboarding Security Rules
    match /organisationOnboarding/{onboardingId} {
      allow read: if isPlatformAdmin() || (signedIn() && sameOrganisation(resource.data.organisationId));
      allow create: if isPlatformAdmin() || (
        signedIn() &&
        role() == 'organisation_admin' &&
        sameOrganisation(request.resource.data.organisationId)
      );
      allow update: if isPlatformAdmin() || (
        signedIn() &&
        role() == 'organisation_admin' &&
        sameOrganisation(resource.data.organisationId) &&
        request.resource.data.organisationId == resource.data.organisationId
      );
      allow delete: if false;
    }

    match /provisioningJobs/{jobId} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /organisationTemplates/{templateId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /{collectionName}/{docId} {
      allow read: if isPeopleCollection(collectionName)
        && inOrganisationOnRead() && isViewer();
      allow create: if isPeopleCollection(collectionName)
        && isProgrammeManager() && inOrganisationOnCreate(docId);
      allow update: if isPeopleCollection(collectionName)
        && isProgrammeManager() && inOrganisationOnUpdate()
        && archiveAuthorityPreserved();

      allow read: if isStaffCollection(collectionName)
        && inOrganisationOnRead() && canReadStaff();
      allow create: if isStaffCollection(collectionName)
        && isAdmin() && inOrganisationOnCreate(docId);
      allow update: if isStaffCollection(collectionName)
        && isAdmin() && inOrganisationOnUpdate();

      allow read: if isAttendanceCollection(collectionName)
        && inOrganisationOnRead() && canReadAttendanceOrEvents();
      allow create: if isAttendanceCollection(collectionName)
        && isTeacher() && inOrganisationOnCreate(docId);
      allow update: if isAttendanceCollection(collectionName)
        && isTeacher() && inOrganisationOnUpdate();

      allow read: if isEventCollection(collectionName)
        && inOrganisationOnRead() && canReadAttendanceOrEvents();
      allow create: if isEventCollection(collectionName)
        && isProgrammeManager() && inOrganisationOnCreate(docId);
      allow update: if isEventCollection(collectionName)
        && isProgrammeManager() && inOrganisationOnUpdate();

      allow read: if isFinanceCollection(collectionName)
        && inOrganisationOnRead()
        && role() in ['super_admin', 'organisation_admin', 'finance', 'viewer'];
      allow create: if isFinanceCollection(collectionName)
        && isFinance() && inOrganisationOnCreate(docId);
      allow update: if isFinanceCollection(collectionName)
        && isFinance() && inOrganisationOnUpdate();

      allow read: if isCommunicationCollection(collectionName)
        && inOrganisationOnRead() && isViewer();
      allow create: if isCommunicationCollection(collectionName)
        && isTeacher() && inOrganisationOnCreate(docId);
      allow update: if isCommunicationCollection(collectionName)
        && isTeacher() && inOrganisationOnUpdate();

      allow read: if isAutomationCollection(collectionName)
        && inOrganisationOnRead()
        && role() in ['super_admin', 'organisation_admin', 'programme_director'];
      allow create: if isAutomationCollection(collectionName)
        && isAdmin() && inOrganisationOnCreate(docId);
      allow update: if isAutomationCollection(collectionName)
        && isAdmin() && inOrganisationOnUpdate();

      allow read: if isWorkforceCollection(collectionName)
        && inOrganisationOnRead()
        && role() in ['super_admin', 'organisation_admin', 'programme_director', 'viewer'];
      allow create: if isWorkforceCollection(collectionName)
        && isProgrammeManager() && inOrganisationOnCreate(docId);
      allow update: if isWorkforceCollection(collectionName)
        && isProgrammeManager() && inOrganisationOnUpdate();

      allow read: if isSettingsCollection(collectionName)
        && inOrganisationOnRead() && canReadSettings();
      allow create: if isSettingsCollection(collectionName)
        && isAdmin() && inOrganisationOnCreate(docId);
      allow update: if isSettingsCollection(collectionName)
        && isAdmin() && inOrganisationOnUpdate();

      allow read: if isPortalCollection(collectionName)
        && inOrganisationOnRead() && isAdmin();
      allow create: if isPortalCollection(collectionName)
        && isAdmin() && inOrganisationOnCreate(docId);
      allow update: if isPortalCollection(collectionName)
        && isAdmin() && inOrganisationOnUpdate();

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
